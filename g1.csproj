<Project Sdk="Godot.NET.Sdk/4.7.0">

  <!--
    Godot 主工程, 引用 Godot 运行时.
    用途: Autoload 单例(Bootstrap), Node 派生类(IView 实现), 场景脚本.
    位置: 根目录(与 project.godot 同级, Godot 4 默认期望).
    纯逻辑代码在 g1.Logic.csproj(scripts/), 通过 ProjectReference 引入.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- 引用纯逻辑程序集, 主工程可见 systems/, views/ 等类型 -->
  <ItemGroup>
    <ProjectReference Include="scripts\logic\g1.Logic.csproj" />
  </ItemGroup>

  <!--
    根目录 csproj 默认递归包含所有子目录 .cs, 需排除归其他工程的目录:
    - scripts/logic/: 归 g1.Logic.csproj
    - tests/: 归 g1.Logic.Tests.csproj, 整体排除
    scripts/ 下其他子目录(autoload/, components/ 等)默认归本工程.
  -->
  <ItemGroup>
    <Compile Remove="scripts\logic\**" />
    <Compile Remove="tests\**" />
  </ItemGroup>

</Project>
