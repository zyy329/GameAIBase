<Project Sdk="Microsoft.NET.Sdk">

  <!--
    纯逻辑程序集, 不引用 Godot 运行时.
    SDK 默认包含本目录及子目录所有 .cs, 即 logic/ 下所有代码自动归属本工程.
    架构强约束: architecture.md 第 1-2 节 (System 纯 C# 类, 禁止持有 Godot Node).
    编译期保证: 本程序集不引用 GodotSharp, 在此写 using Godot 会编译报错.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>g1.Logic</RootNamespace>
  </PropertyGroup>

</Project>
